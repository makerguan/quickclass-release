# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# npm 项目内缓存（start.bat/start.sh 自动指向，随机器生成）
.npm-cache/

# next.js
/.next/
/out/

# production
/build

# distribution
/dist
*.zip

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo

/src/generated/prisma

# database（DATABASE_URL 的 file:./prisma/dev.db 由 Prisma 相对 schema 目录解析，
# 实际库文件位于 prisma/prisma/dev.db）
**/dev.db
**/dev.db-journal
**/dev.db-wal
**/dev.db-shm
# 数据库备份（含真实账户数据，绝不入库）
**/dev.db.bak*

# test artifacts
.playwright-cli/
# 本地临时测试草稿（batch-test、e2e-batch、seed-sim 等，各机器自建，绝不入库）
*.tmp.cjs

# 环境变量（每个部署环境独立配置，不提交）
.env

# 不跟踪分发目录（各自有独立仓库自管）
dist-test/
prisma/prisma/

# 用户上传文件（每个部署环境独立生成）
uploads/
start.log

# 本地构建/安装日志（不入库）
npm-install.log
npm-build.log
