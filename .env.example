# 环境变量模板
# 复制此文件为 .env 并填入实际值

# 数据库 (SQLite - 内置)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth.js 密钥 (运行: openssl rand -base64 32 生成)
NEXTAUTH_SECRET="quickclass-secret-key-2024"
NEXTAUTH_URL="http://localhost:3000"

# 活跃用户统计上报地址（登录时匿名上报，留空则使用代码内默认官方地址）
NEXT_PUBLIC_ANALYTICS_URL="http://www.maoyouhui.org/api/active"
