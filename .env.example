# 环境变量模板
# 复制此文件为 .env 并填入实际值

# 数据库 (SQLite - 内置)
# 注意: file: 后的相对路径按 prisma/schema.prisma 所在目录(即 prisma/)解析,
#       因此 file:./dev.db 的实际文件为 prisma/dev.db。
# 请勿改成 file:./prisma/dev.db —— 那会解析到 prisma/prisma/dev.db,
#       造成"两个数据库文件并存、谁启动连谁"的混乱（历史问题根因）。
DATABASE_URL="file:./dev.db"

# NextAuth.js 密钥 (运行: openssl rand -base64 32 生成)
NEXTAUTH_SECRET="quickclass-secret-key-2024"
NEXTAUTH_URL="http://localhost:3000"

# 活跃用户统计上报地址（登录时匿名上报，留空则使用代码内默认官方地址）
NEXT_PUBLIC_ANALYTICS_URL="http://www.maoyouhui.org/api/active"
